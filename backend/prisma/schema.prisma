// ============================================================
// Artist — Prisma Schema
// Stage 1: Buyer-side marketplace, demo products & artisans.
// Seller/artisan model exists now so product data (badges,
// profiles, "Meet the Makers") is real from day one, even
// though seller self-registration/auth ships in a later stage.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  BUYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_APPLICABLE // demo/seed artisans, pre-seller-onboarding
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  SHIPPED // legacy value, kept for existing rows/migrations; new flow uses the granular stages above/below
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  NOT_APPLICABLE
  PENDING
  PAID
}

enum PaymentMethod {
  ONLINE
  COD
}

enum ReturnStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  COMPLETED
}

// ------------------------------------------------------------
// USERS (Buyers)
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash") // null when signed up via Google
  googleId     String?  @unique @map("google_id")
  avatarUrl    String?  @map("avatar_url")
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now())@updatedAt @map("updated_at")

  wishlist        WishlistItem[]
  cartItems       CartItem[]
  reviews         Review[]
  orders          Order[]          @relation("OrderBuyer")
  confirmedOrders Order[]          @relation("OrderConfirmedBy")
  verifiedArtisans Artisan[]       @relation("ArtisanVerifiedBy")
  recentlyViewed  RecentlyViewed[]

  @@map("users")
}

// ------------------------------------------------------------
// ARTISANS / SELLERS
// ------------------------------------------------------------

model Artisan {
  id                String             @id @default(cuid())
  name              String // shop / brand name shown publicly
  slug              String             @unique
  bio               String
  story             String? // longer "Meet the Makers" narrative
  avatarUrl         String?            @map("avatar_url") // shop logo / profile photo
  coverImageUrl     String?            @map("cover_image_url")
  location          String // display string, e.g. "Khurja, Uttar Pradesh"
  craftSpecialty    String             @map("craft_specialty") // e.g. "Terracotta Pottery"
  yearsOfExperience Int?               @map("years_of_experience")
  verified          Boolean            @default(false)
  verificationStatus VerificationStatus @default(NOT_APPLICABLE) @map("verification_status")
  ratingAvg         Float              @default(0) @map("rating_avg")
  ratingCount       Int                @default(0) @map("rating_count")
  isFeaturedMaker   Boolean            @default(false) @map("is_featured_maker")

  // --- Seller account & auth (separate identity from buyer Users) ---
  email             String?            @unique
  passwordHash      String?            @map("password_hash")
  ownerName         String?            @map("owner_name") // legal name of the person registering
  phone             String?

  // --- Business / compliance details ---
  gstin             String? // optional — not every handmade seller is GST-registered
  pan               String?
  panCardUrl        String?            @map("pan_card_url")
  gstCertificateUrl String?            @map("gst_certificate_url")
  govIdUrl          String?            @map("gov_id_url")
  bankProofUrl      String?            @map("bank_proof_url") // cancelled cheque / passbook photo
  bankDetailsJson   Json?              @map("bank_details_json") // { accountHolderName, accountNumber, ifsc, bankName }

  // Structured pickup address — kept separate from the display-only
  // `location` string specifically so it can be handed to a shipping
  // provider (Shiprocket pickup-location API expects exactly this
  // shape) without reparsing free text later.
  pickupAddress     Json?              @map("pickup_address") // { line1, line2, city, state, pincode, phone }

  // Set the first time a shipment is created for this seller — the
  // shipping provider needs a registered pickup location (not just
  // a free-text address) before it can schedule any pickup from them.
  shippingPickupLocationCode String?   @map("shipping_pickup_location_code")

  // --- Verification audit trail (mirrors Order.adminConfirmedAt/By) ---
  verificationSubmittedAt DateTime?    @map("verification_submitted_at")
  verifiedAt        DateTime?          @map("verified_at")
  verifiedBy        String?            @map("verified_by")
  verifiedByUser    User?              @relation("ArtisanVerifiedBy", fields: [verifiedBy], references: [id])
  rejectionReason   String?            @map("rejection_reason")

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")

  products          Product[]
  orderItems        OrderItem[]

  @@map("artisans")
}

// ------------------------------------------------------------
// CATEGORIES
// ------------------------------------------------------------

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  imageUrl     String?   @map("image_url")
  displayOrder Int       @default(0) @map("display_order")

  products     Product[]

  @@map("categories")
}

// ------------------------------------------------------------
// PRODUCTS
// ------------------------------------------------------------

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String   @map("short_description")
  story            String   // craft storytelling copy for detail page
  craftProcess     String[] @map("craft_process") // ordered steps
  materials        String[]
  images           String[] // Cloudinary URLs, first = primary
  price            Decimal  @db.Decimal(10, 2)
  discountPrice    Decimal? @map("discount_price") @db.Decimal(10, 2)
  currency         String   @default("INR")
  stock            Int      @default(10)
  location         String

  ratingAvg        Float    @default(0) @map("rating_avg")
  ratingCount      Int      @default(0) @map("rating_count")

  isFeatured       Boolean  @default(false) @map("is_featured") // Featured Collection
  isEditorsPick    Boolean  @default(false) @map("is_editors_pick") // Editor's Picks
  isTrending       Boolean  @default(false) @map("is_trending") // Trending Products (seed flag; live trending computed via Redis)

  categoryId       String   @map("category_id")
  category         Category @relation(fields: [categoryId], references: [id])

  artisanId        String   @map("artisan_id")
  artisan          Artisan  @relation(fields: [artisanId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now())@updatedAt @map("updated_at")

  reviews          Review[]
  wishlistedBy     WishlistItem[]
  cartOf           CartItem[]
  orderItems       OrderItem[]
  recentlyViewedBy RecentlyViewed[]

  @@index([categoryId])
  @@index([artisanId])
  @@index([isFeatured])
  @@index([isEditorsPick])
  @@index([isTrending])
  @@map("products")
}

// ------------------------------------------------------------
// REVIEWS
// ------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // one review per buyer per product
  @@index([productId])
  @@map("reviews")
}

// ------------------------------------------------------------
// CART
// ------------------------------------------------------------

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now())@updatedAt @map("updated_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

// ------------------------------------------------------------
// WISHLIST
// ------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ------------------------------------------------------------
// RECENTLY VIEWED (durable backstop; Redis holds the hot path)
// ------------------------------------------------------------

model RecentlyViewed {
  id        String   @id @default(cuid())
  viewedAt  DateTime @default(now()) @map("viewed_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("recently_viewed")
}

// ------------------------------------------------------------
// ORDERS
// ------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  status        OrderStatus   @default(PENDING)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)

  // Payment (Razorpay for ONLINE; COD skips Razorpay entirely and
  // gets marked PAID automatically when the courier confirms delivery)
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod     PaymentMethod @default(ONLINE) @map("payment_method")
  codAmount         Decimal?      @map("cod_amount") @db.Decimal(10, 2)

  // Delivery
  shippingAddress Json?         @map("shipping_address")

  // Admin confirms delivery happened before sellers get marked payable
  // (kept for the manual/admin-only path; the shipment-driven path
  // below reaches the same payout trigger automatically on DELIVERED)
  adminConfirmedAt DateTime?    @map("admin_confirmed_at")
  adminConfirmedBy String?      @map("admin_confirmed_by")
  confirmedByUser  User?        @relation("OrderConfirmedBy", fields: [adminConfirmedBy], references: [id])

  // --- Shipping provider (Shiprocket or equivalent) ---
  // Deliberately provider-agnostic field names (not "shiprocketAwb"
  // etc.) so swapping providers later is a config change, not a
  // schema change.
  shippingProvider    String?    @default("shiprocket") @map("shipping_provider")
  providerOrderId     String?    @map("provider_order_id")
  providerShipmentId  String?    @map("provider_shipment_id")
  awbCode             String?    @map("awb_code")
  courierName         String?    @map("courier_name")
  labelUrl            String?    @map("label_url")
  manifestUrl         String?    @map("manifest_url")
  pickupScheduledAt   DateTime?  @map("pickup_scheduled_at")
  packageWeightKg     Decimal?   @map("package_weight_kg") @db.Decimal(6, 3)
  packageDimensionsCm Json?      @map("package_dimensions_cm") // { lengthCm, widthCm, heightCm }
  lastTrackingSyncAt  DateTime?  @map("last_tracking_sync_at")

  // --- Returns ---
  returnStatus      ReturnStatus @default(NONE) @map("return_status")
  returnReason      String?      @map("return_reason")
  returnRequestedAt DateTime?    @map("return_requested_at")
  returnAwbCode     String?      @map("return_awb_code")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now())@updatedAt @map("updated_at")

  userId        String        @map("user_id")
  user          User          @relation("OrderBuyer", fields: [userId], references: [id])

  items         OrderItem[]
  shipmentEvents ShipmentEvent[]

  @@map("orders")
}

// The tracking timeline shown to buyers/sellers/admins. One row per
// status change, whether it came from a courier webhook, a polling
// sync, or a manual admin action — same table either way, so the
// timeline is always a complete, chronological record regardless of
// where an update originated.
model ShipmentEvent {
  id               String   @id @default(cuid())
  status           OrderStatus // our normalized status at this event
  providerStatus   String?     @map("provider_status") // raw string from the shipping provider, kept for debugging
  description      String?
  occurredAt       DateTime    @default(now()) @map("occurred_at")
  source           String      @default("webhook") @map("source") // "webhook" | "poll" | "admin" | "seller" | "system"
  rawPayload       Json?       @map("raw_payload")

  orderId          String   @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipment_events")
}

model OrderItem {
  id             String       @id @default(cuid())
  quantity       Int
  priceEach      Decimal      @map("price_each") @db.Decimal(10, 2)

  // Commission split, locked in at checkout time
  platformFee    Decimal      @default(0) @map("platform_fee") @db.Decimal(10, 2)
  sellerAmount   Decimal      @default(0) @map("seller_amount") @db.Decimal(10, 2)
  payoutStatus   PayoutStatus @default(NOT_APPLICABLE) @map("payout_status")
  payoutMarkedAt DateTime?    @map("payout_marked_at")

  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  artisanId String? @map("artisan_id")
  artisan   Artisan? @relation(fields: [artisanId], references: [id])

  @@map("order_items")
}