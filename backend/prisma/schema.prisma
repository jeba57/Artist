// ============================================================
// Artist — Prisma Schema
// Stage 1: Buyer-side marketplace, demo products & artisans.
// Seller/artisan model exists now so product data (badges,
// profiles, "Meet the Makers") is real from day one, even
// though seller self-registration/auth ships in a later stage.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  BUYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_APPLICABLE // demo/seed artisans, pre-seller-onboarding
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  NOT_APPLICABLE
  PENDING
  PAID
}

// ------------------------------------------------------------
// USERS (Buyers)
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash") // null when signed up via Google
  googleId     String?  @unique @map("google_id")
  avatarUrl    String?  @map("avatar_url")
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now())@updatedAt @map("updated_at")

  wishlist        WishlistItem[]
  cartItems       CartItem[]
  reviews         Review[]
  orders          Order[]          @relation("OrderBuyer")
  confirmedOrders Order[]          @relation("OrderConfirmedBy")
  recentlyViewed  RecentlyViewed[]

  @@map("users")
}

// ------------------------------------------------------------
// ARTISANS / SELLERS
// ------------------------------------------------------------

model Artisan {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  bio               String
  story             String? // longer "Meet the Makers" narrative
  avatarUrl         String?            @map("avatar_url")
  coverImageUrl     String?            @map("cover_image_url")
  location          String
  craftSpecialty    String             @map("craft_specialty") // e.g. "Terracotta Pottery"
  yearsOfExperience Int?               @map("years_of_experience")
  verified          Boolean            @default(false)
  verificationStatus VerificationStatus @default(NOT_APPLICABLE) @map("verification_status")
  ratingAvg         Float              @default(0) @map("rating_avg")
  ratingCount       Int                @default(0) @map("rating_count")
  isFeaturedMaker   Boolean            @default(false) @map("is_featured_maker")

  // Future: seller auth fields (unused in Stage 1)
  email             String?            @unique
  passwordHash      String?            @map("password_hash")
  govIdUrl          String?            @map("gov_id_url")
  bankDetailsJson   Json?              @map("bank_details_json")

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now())@updatedAt @map("updated_at")

  products          Product[]
  orderItems        OrderItem[]

  @@map("artisans")
}

// ------------------------------------------------------------
// CATEGORIES
// ------------------------------------------------------------

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  imageUrl     String?   @map("image_url")
  displayOrder Int       @default(0) @map("display_order")

  products     Product[]

  @@map("categories")
}

// ------------------------------------------------------------
// PRODUCTS
// ------------------------------------------------------------

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String   @map("short_description")
  story            String   // craft storytelling copy for detail page
  craftProcess     String[] @map("craft_process") // ordered steps
  materials        String[]
  images           String[] // Cloudinary URLs, first = primary
  price            Decimal  @db.Decimal(10, 2)
  discountPrice    Decimal? @map("discount_price") @db.Decimal(10, 2)
  currency         String   @default("INR")
  stock            Int      @default(10)
  location         String

  ratingAvg        Float    @default(0) @map("rating_avg")
  ratingCount      Int      @default(0) @map("rating_count")

  isFeatured       Boolean  @default(false) @map("is_featured") // Featured Collection
  isEditorsPick    Boolean  @default(false) @map("is_editors_pick") // Editor's Picks
  isTrending       Boolean  @default(false) @map("is_trending") // Trending Products (seed flag; live trending computed via Redis)

  categoryId       String   @map("category_id")
  category         Category @relation(fields: [categoryId], references: [id])

  artisanId        String   @map("artisan_id")
  artisan          Artisan  @relation(fields: [artisanId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now())@updatedAt @map("updated_at")

  reviews          Review[]
  wishlistedBy     WishlistItem[]
  cartOf           CartItem[]
  orderItems       OrderItem[]
  recentlyViewedBy RecentlyViewed[]

  @@index([categoryId])
  @@index([artisanId])
  @@index([isFeatured])
  @@index([isEditorsPick])
  @@index([isTrending])
  @@map("products")
}

// ------------------------------------------------------------
// REVIEWS
// ------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // one review per buyer per product
  @@index([productId])
  @@map("reviews")
}

// ------------------------------------------------------------
// CART
// ------------------------------------------------------------

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now())@updatedAt @map("updated_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

// ------------------------------------------------------------
// WISHLIST
// ------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ------------------------------------------------------------
// RECENTLY VIEWED (durable backstop; Redis holds the hot path)
// ------------------------------------------------------------

model RecentlyViewed {
  id        String   @id @default(cuid())
  viewedAt  DateTime @default(now()) @map("viewed_at")

  userId    String @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("recently_viewed")
}

// ------------------------------------------------------------
// ORDERS
// ------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  status        OrderStatus   @default(PENDING)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)

  // Payment (Razorpay)
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")

  // Delivery
  shippingAddress Json?         @map("shipping_address")

  // Admin confirms delivery happened before sellers get marked payable
  adminConfirmedAt DateTime?    @map("admin_confirmed_at")
  adminConfirmedBy String?      @map("admin_confirmed_by")
  confirmedByUser  User?        @relation("OrderConfirmedBy", fields: [adminConfirmedBy], references: [id])

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now())@updatedAt @map("updated_at")

  userId        String        @map("user_id")
  user          User          @relation("OrderBuyer", fields: [userId], references: [id])

  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String       @id @default(cuid())
  quantity       Int
  priceEach      Decimal      @map("price_each") @db.Decimal(10, 2)

  // Commission split, locked in at checkout time
  platformFee    Decimal      @default(0) @map("platform_fee") @db.Decimal(10, 2)
  sellerAmount   Decimal      @default(0) @map("seller_amount") @db.Decimal(10, 2)
  payoutStatus   PayoutStatus @default(NOT_APPLICABLE) @map("payout_status")
  payoutMarkedAt DateTime?    @map("payout_marked_at")

  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  artisanId String? @map("artisan_id")
  artisan   Artisan? @relation(fields: [artisanId], references: [id])

  @@map("order_items")
}